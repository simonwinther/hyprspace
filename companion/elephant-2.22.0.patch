+package common
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"sync"
+	"testing"
+)
+
+func TestContextCommandPreservesRequests(t *testing.T) {
+	directory := t.TempDir()
+	helper := filepath.Join(directory, "hyprspace-launch")
+	if err := os.WriteFile(helper, []byte("#!/bin/sh\nprintf '%s\\n' \"$@\"\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", directory+":/usr/bin:/bin")
+	t.Setenv("HYPRSPACE_LAUNCH_TOKEN", "parent-unchanged")
+	program := "printf '%s' 'spaces; $(literal)'; uwsm-app -- app 'a b'"
+	var workers sync.WaitGroup
+	for _, token := range []string{"first-destination", "second-destination"} {
+		workers.Add(1)
+		go func(token string) {
+			defer workers.Done()
+			cmd := ContextCommand(token, program)
+			want := []string{helper, "--context", token, "--", "sh", "-c", program}
+			if !reflect.DeepEqual(cmd.Args, want) {
+				t.Errorf("args = %#v", cmd.Args)
+			}
+			if _, err := cmd.Output(); err != nil {
+				t.Error(err)
+			}
+		}(token)
+	}
+	workers.Wait()
+	if os.Getenv("HYPRSPACE_LAUNCH_TOKEN") != "parent-unchanged" {
+		t.Fatal("shared environment changed")
+	}
+	for _, token := range []string{"", "bad token", "$(touch nope)"} {
+		cmd := ContextCommand(token, program)
+		if !reflect.DeepEqual(cmd.Args, []string{"sh", "-c", program}) {
+			t.Errorf("native fallback args = %#v", cmd.Args)
+		}
+	}
+}
