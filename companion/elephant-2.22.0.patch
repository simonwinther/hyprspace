+
+func TestActivationContextAndLegacyProvider(t *testing.T) {
+	name := "fixture"
+	previous := providers.Providers
+	defer func() { providers.Providers = previous }()
+	for _, contextual := range []bool{false, true} {
+		for _, format := range []uint8{0, 1} {
+			called := 0
+			provider := providers.Provider{Name: &name, Activate: func(single bool, id, action, query, args string, f uint8, conn net.Conn) { called++ }}
+			if contextual {
+				provider.ActivateWithContext = func(single bool, id, action, query, args string, f uint8, conn net.Conn, context string) {
+					called++
+					if context != "opaque-request" || args != "original arguments" || action != "run" {
+						t.Errorf("lost activation context or arguments")
+					}
+				}
+			}
+			providers.Providers = map[string]providers.Provider{name: provider}
+			req := &pb.ActivateRequest{Provider: name, Identifier: "id", Action: "run", Arguments: "original arguments", Context: "opaque-request"}
+			data, _ := proto.Marshal(req)
+			if format == 1 {
+				data, _ = json.Marshal(req)
+			}
+			server, client := net.Pipe()
+			client.SetDeadline(time.Now().Add(time.Second))
+			done := make(chan struct{})
+			go func() { (&ActivateRequest{}).Handle(format, 0, server, data); server.Close(); close(done) }()
+			if _, err := io.ReadAll(client); err != nil {
+				t.Fatal(err)
+			}
+			client.Close()
+			<-done
+			if called != 1 {
+				t.Fatalf("activation count = %d", called)
+			}
+		}
+	}
+}
