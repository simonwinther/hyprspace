@@ -0,0 +1,21 @@
+package common
+
+import (
+	"os/exec"
+	"strings"
+)
+
+// ContextCommand preserves the original shell program and every argument.
+// Context is per activation request, never a shared provider environment.
+func ContextCommand(context, command string) *exec.Cmd {
+	if context == "" || len(context) > 128 || strings.IndexFunc(context, func(r rune) bool {
+		return !(r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '-')
+	}) >= 0 {
+		return exec.Command("sh", "-c", command)
+	}
+	helper, err := exec.LookPath("hyprspace-launch")
+	if err != nil {
+		return exec.Command("sh", "-c", command)
+	}
+	return exec.Command(helper, "--context", context, "--", "sh", "-c", command)
+}
