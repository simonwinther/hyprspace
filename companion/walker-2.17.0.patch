+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::protos::generated_proto::activate::ActivateRequest;
+    use protobuf::Message;
+    use std::io::{Read, Write};
+    use std::os::fd::FromRawFd;
+    use std::os::unix::net::UnixStream;
+
+    #[test]
+    fn captures_each_activation_over_an_instance_socket() {
+        let path = format!("/tmp/walker-context-{}.sock", std::process::id());
+        let mut address: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+        address.sun_family = libc::AF_UNIX as _;
+        for (dst, src) in address.sun_path.iter_mut().zip(path.bytes()) {
+            *dst = src as _;
+        }
+        let fd =
+            unsafe { libc::socket(libc::AF_UNIX, libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC, 0) };
+        assert!(fd >= 0);
+        let _server = unsafe { UnixStream::from_raw_fd(fd) };
+        assert_eq!(
+            unsafe {
+                libc::bind(
+                    fd,
+                    &address as *const _ as *const libc::sockaddr,
+                    std::mem::size_of_val(&address) as _,
+                )
+            },
+            0
+        );
+        assert_eq!(unsafe { libc::listen(fd, 2) }, 0);
+        let worker = std::thread::spawn(move || {
+            for token in ["first-workspace", "second-workspace"] {
+                let peer = unsafe {
+                    libc::accept4(
+                        fd,
+                        std::ptr::null_mut(),
+                        std::ptr::null_mut(),
+                        libc::SOCK_CLOEXEC,
+                    )
+                };
+                assert!(peer >= 0);
+                let mut connection = unsafe { UnixStream::from_raw_fd(peer) };
+                let mut message = [0; 16];
+                let count = connection.read(&mut message).unwrap();
+                assert_eq!(&message[..count], b"capture");
+                connection.write_all(token.as_bytes()).unwrap();
+            }
+        });
+        assert_eq!(capture_from(&path), "first-workspace");
+        assert_eq!(capture_from(&path), "second-workspace");
+        worker.join().unwrap();
+        std::fs::remove_file(path).unwrap();
+        assert_eq!(capture_from("/nonexistent/walker.sock"), "");
+    }
+
+    #[test]
+    fn activation_context_is_an_optional_wire_field() {
+        let mut request = ActivateRequest::new();
+        request.provider = "runner".into();
+        let old = request.write_to_bytes().unwrap();
+        assert!(
+            ActivateRequest::parse_from_bytes(&old)
+                .unwrap()
+                .context
+                .is_empty()
+        );
+        request.context = "opaque-destination".into();
+        let decoded =
+            ActivateRequest::parse_from_bytes(&request.write_to_bytes().unwrap()).unwrap();
+        assert_eq!(decoded.context, "opaque-destination");
+        assert_eq!(decoded.provider, "runner");
+    }
+}
