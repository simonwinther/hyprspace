+// Capture at result activation, including mouse and keep-open actions.
+// The compositor socket is private to this instance and accepts one packet.
+fn socket_path() -> Option<String> {
+    let runtime = std::env::var("XDG_RUNTIME_DIR").ok()?;
+    let instance = std::env::var("HYPRLAND_INSTANCE_SIGNATURE").ok()?;
+    if instance.contains('/') {
+        return None;
+    }
+    Some(format!("{runtime}/hypr/{instance}/hyprspace.sock"))
+}
+
+pub fn capture() -> String {
+    socket_path()
+        .map(|path| capture_from(&path))
+        .unwrap_or_default()
+}
+
+fn capture_from(path: &str) -> String {
+    request_from(path, b"capture", std::time::Duration::from_millis(300))
+}
+
+fn request_from(path: &str, message: &[u8], duration: std::time::Duration) -> String {
+    use std::io::{Read, Write};
+    use std::os::fd::FromRawFd;
+    use std::os::unix::net::UnixStream;
+    // SOCK_SEQPACKET preserves framing without sharing state between requests.
+    let mut address: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+    if path.len() >= address.sun_path.len() {
+        return String::new();
+    }
+    address.sun_family = libc::AF_UNIX as _;
+    for (dst, src) in address.sun_path.iter_mut().zip(path.bytes()) {
+        *dst = src as _;
+    }
+    let fd = unsafe { libc::socket(libc::AF_UNIX, libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC, 0) };
+    if fd < 0 {
+        return String::new();
+    }
+    let mut stream = unsafe { UnixStream::from_raw_fd(fd) };
+    let timeout = Some(duration);
+    let _ = stream.set_read_timeout(timeout);
+    let _ = stream.set_write_timeout(timeout);
+    if unsafe {
+        libc::connect(
+            fd,
+            &address as *const _ as *const libc::sockaddr,
+            std::mem::size_of_val(&address) as _,
+        )
+    } != 0
+    {
+        return String::new();
+    }
+    if stream.write_all(message).is_err() {
+        return String::new();
+    }
+    let mut token = [0; 128];
+    let Ok(count) = stream.read(&mut token) else {
+        return String::new();
+    };
+    let value = String::from_utf8_lossy(&token[..count]);
+    if !value
+        .bytes()
+        .all(|b| b.is_ascii_alphanumeric() || b == b'-')
+    {
+        return String::new();
+    }
+    value.into_owned()
+}
+
+// Walker's transparent layer spans an output. During an overview, only its
+// visible panel should own pointer input. Popups keep their native surfaces.
+// Probe off the UI thread and restore the ordinary full input region on close
+// or compositor/plugin loss. No compositor roundtrip blocks a GTK frame.
+pub fn scope_input_region(window: &gtk4::Window, content: &gtk4::Box) {
+    use gtk4::glib::translate::ToGlibPtr;
+    use gtk4::prelude::*;
+    use std::sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    };
+    use std::time::Duration;
+    let Some(path) = socket_path() else { return };
+    let active = Arc::new(AtomicBool::new(false));
+    let visible = Arc::new(AtomicBool::new(false));
+    let alive = Arc::new(AtomicBool::new(true));
+    let (worker_active, worker_visible, worker_alive) =
+        (active.clone(), visible.clone(), alive.clone());
+    std::thread::spawn(move || {
+        while worker_alive.load(Ordering::Relaxed) {
+            let enabled = worker_visible.load(Ordering::Relaxed)
+                && request_from(&path, b"active", Duration::from_millis(20)) == "1";
+            worker_active.store(enabled, Ordering::Relaxed);
+            std::thread::sleep(Duration::from_millis(100));
+        }
+    });
+    let window = window.downgrade();
+    let content = content.downgrade();
+    let mut previous = None;
+    gtk4::glib::timeout_add_local(Duration::from_millis(50), move || {
+        let (Some(window), Some(content)) = (window.upgrade(), content.upgrade()) else {
+            alive.store(false, Ordering::Relaxed);
+            return gtk4::glib::ControlFlow::Break;
+        };
+        visible.store(window.is_visible(), Ordering::Relaxed);
+        let region = if window.is_visible() && active.load(Ordering::Relaxed) {
+            content.compute_bounds(&window).map(|bounds| {
+                (
+                    bounds.x().floor() as i32,
+                    bounds.y().floor() as i32,
+                    bounds.width().ceil() as i32,
+                    bounds.height().ceil() as i32,
+                )
+            })
+        } else {
+            None
+        };
+        if region != previous {
+            if let Some(surface) = window.surface() {
+                if let Some((x, y, width, height)) = region {
+                    surface.set_input_region(&gtk4::cairo::Region::create_rectangle(
+                        &gtk4::cairo::RectangleInt::new(x, y, width, height),
+                    ));
+                } else {
+                    unsafe {
+                        gtk4::gdk::ffi::gdk_surface_set_input_region(
+                            surface.to_glib_none().0,
+                            std::ptr::null_mut(),
+                        );
+                    }
+                }
+                window.queue_draw();
+                previous = region;
+            }
+        }
+        gtk4::glib::ControlFlow::Continue
+    });
+}
