{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "version-file": "version.txt",
      "initial-version": "1.0.0",
      "include-component-in-tag": false,
      "draft": true,
      "force-tag-creation": true,
      "pull-request-title-pattern": "chore(release): prepare ${version}",
      "pull-request-header": "Review the release notes and compatibility evidence before merging.",
      "pull-request-footer": "Publication remains a separate maintainer action.",
      "extra-files": [
        { "type": "toml", "path": "hyprpm.toml", "jsonpath": "$.hyprspace.version" },
        "src/Version.hpp"
      ]
    }
  }
}
